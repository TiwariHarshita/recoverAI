# Local development database started by docker-compose.postgres.yml.
DATABASE_URL=postgresql+psycopg://recoverai:recoverai@localhost:5433/recoverai

# Razorpay Test Mode only. Never commit a real key secret.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_TIMEOUT_SECONDS=10

# Razorpay webhook signing secret. This is NOT the API key secret.
RAZORPAY_WEBHOOK_SECRET=replace_with_random_webhook_secret
